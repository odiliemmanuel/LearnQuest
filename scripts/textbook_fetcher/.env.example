# Get a free key at https://aistudio.google.com/apikey (no credit card needed)
GEMINI_API_KEY=

# Must match INGEST_SECRET in backend/.env — the backend's dev default is
# "dev-ingest-secret-change-me" if you haven't set your own yet.
INGEST_KEY=dev-ingest-secret-change-me

# Where your backend is running
BACKEND_URL=http://localhost:8080


# If gemini-3.5-flash ever errors as an unknown model, check the current
# list at https://ai.google.dev/gemini-api/docs/models and swap it here.
GEMINI_MODEL=gemini-3.5-flash

# How often (in hours) the continuous loop re-checks for newly-added
# curriculum topics. Ignored when running with --once.
POLL_INTERVAL_HOURS=6

# Pause between topics, so you don't hammer the Gemini free tier.
REQUEST_DELAY_SECONDS=3

# Google Search grounding is OFF by default. Since Google's December 2025
# free-tier cuts, grounded requests trigger 429 errors almost immediately
# on free-tier keys — plain generation works fine. Only set this to true
# once you have billing enabled on your Google Cloud project.
USE_GROUNDING=false

# How many times to retry a single topic after a 429 (rate limit) error
# before giving up on it and moving to the next topic.
MAX_RETRIES=3

# Seconds to wait before a retry, multiplied by the attempt number
# (so: 20s, then 40s, then 60s).
RETRY_BACKOFF_SECONDS=20
