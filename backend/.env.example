# Copy to .env and fill in. NEVER commit .env — it is already gitignored.
# Generate a secret with:  openssl rand -base64 48

# ---- Runtime ----------------------------------------------------------------
# "production" enforces the secret checks below (server refuses to boot without
# them). Use "development" locally.
APP_ENV=production
PORT=8080

# ---- Required in production -------------------------------------------------
# Postgres connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/learnquest?sslmode=require
# Signs JWTs. Changing it logs every user out.
JWT_SECRET=
# Signs OTP codes for email verification. Defaults to JWT_SECRET if unset.
OTP_SECRET=
# Used by the separate notification service.
RABBITMQ_URL=amqp://USER:PASSWORD@HOST:5672/
# Shared secret for the textbook fetcher's ingest endpoint.
INGEST_SECRET=

# ---- Optional ---------------------------------------------------------------
JWT_TTL_MINUTES=10080
# Comma-separated allowed browser origins, e.g. https://app.yourdomain.com
# Only needed when the frontend is NOT served from the same origin as the API.
CORS_ORIGINS=https://app.yourdomain.com
# Leave the key empty to run the AI layer in mock mode (no external calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
# Seeded account promoted to ADMIN on first boot.
ADMIN_EMAIL=
# Defaults to internal/seed/content; override if the content dir is mounted
# somewhere else.
# SEED_CONTENT_DIR=/app/internal/seed/content
# Set to 1 to re-run the curriculum seed even if data already exists.
# SEED_FORCE=0