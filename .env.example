# Docker Compose deployment secrets. Copy to .env and fill in.
# This file is gitignored. NEVER commit it.
# Generate each secret with:  openssl rand -base64 48
#
# Only the backend container reads this file. Compose also uses it to
# interpolate ${VARS} in docker-compose.yml.

# ---- Postgres (used by the db container and to build DATABASE_URL) --------
POSTGRES_USER=learnquest
POSTGRES_PASSWORD=
POSTGRES_DB=learnquest

# ---- RabbitMQ (used by the broker container and to build RABBITMQ_URL) ----
RABBITMQ_USER=learnquest
RABBITMQ_PASSWORD=
RABBITMQ_UI_PORT=15672

# ---- Backend --------------------------------------------------------------
# "production" makes the server refuse to boot without the secrets below.
APP_ENV=production
JWT_SECRET=
OTP_SECRET=
# Shared secret for the textbook fetcher's ingest endpoint.
INGEST_SECRET=

# Leave OPENAI_API_KEY empty to run the AI layer in mock mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
JWT_TTL_MINUTES=10080

# The seeded account promoted to ADMIN on first boot.
ADMIN_EMAIL=

# Browser origins allowed to call the API. REQUIRED when the frontend runs on a
# different origin, i.e. the Vercel deployment. Exact match only, no wildcards.
# e.g. CORS_ORIGINS=https://learnquest.vercel.app
# (Only leave blank if the frontend is served from the same origin as the API.)
CORS_ORIGINS=

# Host port for the web UI (only used by the local docker-compose.yml).
WEB_PORT=8081

# ---- Public API domain (docker-compose.prod.yml / Oracle VM) --------------
# The hostname Caddy serves the API on and gets a TLS certificate for. Point an
# A record at the VM's public IP before first boot, e.g. api.yourdomain.com.
# No domain yet? Use <VM_PUBLIC_IP>.sslip.io — resolves to the IP and works
# with Let's Encrypt.
API_DOMAIN=

# ---- Notification service (email delivery) --------------------------------
# SMTP credentials. On alwaysdata these are your mailbox/site SMTP details.
SMTP_HOST=smtp-XXXX.alwaysdata.net
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Run the email verification consumer INSIDE the backend process instead of
# the separate notification-service. Set to true on hosts without background
# workers (e.g. Render's free web service). Requires the SMTP_* vars above.
RUN_EMAIL_CONSUMER=false

# Email transport: "smtp" (default) or "brevo". Render's free tier blocks
# outbound SMTP ports 25/465/587, so use "brevo" there — it sends over HTTPS.
# EMAIL_FROM must be a sender verified in your Brevo account.
EMAIL_PROVIDER=smtp
BREVO_API_KEY=