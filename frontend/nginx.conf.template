server {
    # PaaS platforms (Render, Railway) inject PORT and expect the server to
    # bind it. Defaults to 80 for local/compose use.
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Admin/seed uploads (avatars, book text) can be large.
    client_max_body_size 25m;

    # The frontend calls the API with relative paths (/api/v1/...), so nginx
    # proxies them to the backend. BACKEND_URL is substituted at container
    # start from the environment, so the same image works for the compose
    # setup (http://backend:8080) and for a PaaS (https://api.example.com).
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Hashed build assets are immutable; index.html must never be cached or
    # clients keep booting an old bundle after a deploy.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate";
    }

    # SPA fallback: BrowserRouter routes like /library must serve index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
